# SSH connection configuration for cellular-dashboard-remote.py
# Copy this file to .env and fill in your values.

# Path to the SSH private key (passphrase will be prompted interactively)
SSH_KEY=~/.ssh/id_ed25519

# Jump / bastion host  (user@host)
JUMP_HOST=root@192.168.1.1

# Target host  (user@host)
# IPv6 link-local addresses must include the local interface scope, e.g. fe80::...%eth4
TARGET_HOST=szotdaniel@fe80::8e30:66ff:fed0:ffe5%eth4

# Comma-separated list of QMI device paths on the remote host.
# Leave blank to auto-detect (/dev/wwan0qmi0 and /dev/wwan1qmi0).
QMI_DEVICES=
